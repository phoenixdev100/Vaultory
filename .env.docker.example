# docker-compose.yml already carries defaults for every value below - a .env
# file is OPTIONAL. Copy only if you want to override the baked-in secrets
# (recommended for any non-private install).

POSTGRES_PASSWORD=
SESSION_SECRET=
VAULT_WRAP_SECRET=

